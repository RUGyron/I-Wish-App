    "All participants will be removed, invitations revoked. The list becomes private.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All participants will be removed, invitations revoked. The list becomes private."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все участники будут удалены, инвайты отозваны. Список станет приватным."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán todos los participantes y se revocarán las invitaciones. La lista pasará a ser privada."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Teilnehmer werden entfernt, Einladungen widerrufen. Die Liste wird privat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les participants seront retirés et les invitations révoquées. La liste deviendra privée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i partecipanti verranno rimossi, gli inviti revocati. La lista diventerà privata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "全参加者が削除され、招待は取り消されます。リストはプライベートになります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有参与者将被移除,邀请将被撤销。列表将变为私密。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 참여자가 제거되고 초대가 취소돼요. 리스트는 비공개로 전환됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os participantes serão removidos e os convites revogados. A lista ficará privada."
          }
        }
      }
    },
