    "Receive push when wishes are added/edited/removed in this list. Works only when notifications are enabled in Settings.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Receive push when wishes are added/edited/removed in this list. Works only when notifications are enabled in Settings."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Получать push при добавлении/изменении/удалении желаний в этом списке. Работает только при включённых уведомлениях в Настройках."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibe notificaciones push cuando se añaden, editan o eliminan deseos en esta lista. Solo funciona si las notificaciones están activadas en Ajustes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Push-Mitteilungen erhalten, wenn Wünsche in dieser Liste hinzugefügt, bearbeitet oder entfernt werden. Funktioniert nur, wenn Mitteilungen in den Einstellungen aktiviert sind."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reçois des notifications push lorsque des vœux sont ajoutés, modifiés ou supprimés dans cette liste. Fonctionne uniquement si les notifications sont activées dans Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricevi notifiche push quando i desideri vengono aggiunti/modificati/rimossi in questa lista. Funziona solo se le notifiche sono attive nelle Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリストで願いの追加・編集・削除があったときにプッシュ通知を受け取ります。「設定」で通知が有効な場合のみ動作します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在此列表中添加、编辑或移除心愿时接收推送通知。仅在系统“设置”中启用通知后才能生效。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 리스트에서 위시가 추가·수정·삭제되면 푸시 알림을 받아요. 설정에서 알림이 켜진 경우에만 동작해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Receba notificações push quando desejos forem adicionados, editados ou removidos nesta lista. Só funciona com as notificações ativadas em Ajustes."
          }
        }
      }
    },
    "Re-authentication with Apple ID is required": {
