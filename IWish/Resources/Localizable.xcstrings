    "All your lists, memberships, and encryption keys will be deleted permanently. This action can’t be undone.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All your lists, memberships, and encryption keys will be deleted permanently. This action can’t be undone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все ваши списки, участия и ключи шифрования будут удалены безвозвратно. Действие нельзя отменить."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas tus listas, participaciones y claves de cifrado se eliminarán de forma permanente. Esta acción no se puede deshacer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Ihre Listen, Mitgliedschaften und Schlüssel werden dauerhaft gelöscht. Diese Aktion kann nicht rückgängig gemacht werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes tes listes, participations et clés de chiffrement seront supprimées définitivement. Cette action est irréversible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutte le tue liste, partecipazioni e chiavi di cifratura saranno eliminate definitivamente. L’azione non può essere annullata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リスト、参加情報、暗号鍵がすべて完全に削除されます。この操作は元に戻せません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你所有的列表、成员关系和加密密钥将被永久删除。此操作无法撤销。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 리스트, 참여 정보, 암호화 키가 영구적으로 삭제돼요. 이 작업은 되돌릴 수 없어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as suas listas, participações e chaves de criptografia serão excluídas para sempre. Esta ação não pode ser desfeita."
          }
        }
      }
    },
