    "This action is irreversible. Confirm with Apple ID to continue.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This action is irreversible. Confirm with Apple ID to continue."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Действие необратимо. Подтвердите вход через Apple ID, чтобы продолжить."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta acción es irreversible. Confirma con tu Apple ID para continuar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Aktion ist endgültig. Bitte mit der Apple-ID bestätigen, um fortzufahren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action est irréversible. Confirme avec ton identifiant Apple pour continuer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’azione è irreversibile. Conferma con l’ID Apple per continuare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この操作は取り消せません。続けるにはApple IDで認証してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作不可撤销。请使用 Apple ID 确认以继续。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 작업은 되돌릴 수 없어요. 계속하려면 Apple ID로 확인해 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta ação é irreversível. Confirme com seu Apple ID para continuar."
          }
        }
      }
    },
