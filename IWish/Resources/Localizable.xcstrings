    "Limit reached in this list — %lld wishes. Delete unused ones.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Limit reached in this list — %lld wishes. Delete unused ones."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В списке достигнут лимит — %lld желаний. Удалите ненужные."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Límite alcanzado en esta lista: %lld deseos. Elimina los que no uses."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Limit in dieser Liste erreicht — %lld Wünsche. Bitte unbenutzte löschen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Limite atteinte dans cette liste — %lld vœux. Supprime ceux qui ne servent plus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Limite raggiunto in questa lista: %lld desideri. Elimina quelli non usati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリストの上限に達しました — %lld件。使わない願いを削除してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此列表已达上限 — %lld 个心愿。请删除不需要的。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 리스트의 한도에 도달했어요 — 위시 %lld개. 사용하지 않는 항목을 삭제해 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Limite atingido nesta lista — %lld desejos. Exclua os que não usa."
          }
        }
      }
    },
