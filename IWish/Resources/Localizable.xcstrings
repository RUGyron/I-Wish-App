    "The owner can’t remove themselves — delete the list instead": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The owner can’t remove themselves — delete the list instead"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Владелец не может удалить себя — удалите список целиком"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El propietario no puede eliminarse a sí mismo — elimina la lista entera"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Inhaber kann sich nicht selbst entfernen — löschen Sie stattdessen die Liste"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le propriétaire ne peut pas se retirer — supprime plutôt la liste"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il proprietario non può rimuovere se stesso — elimina la lista"
