          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per scansionare i QR code, consenti l’accesso alla fotocamera nelle Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
