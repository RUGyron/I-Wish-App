        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У вас слишком много пустых списков. Сначала удалите или заполните их."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tienes demasiadas listas vacías. Bórralas o rellénalas primero."
