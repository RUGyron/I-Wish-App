          "stringUnit": {
            "state": "translated",
            "value": "Желание скроется до окончания срока — если за это время не передумаешь, оно останется."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El deseo permanece oculto hasta que acabe el periodo — si no cambias de opinión, se queda."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Wunsch bleibt bis zum Ende der Frist verborgen — überlegen Sie es sich nicht anders, bleibt er erhalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le vœu reste caché jusqu’à la fin de la période — si tu ne changes pas d’avis, il reste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il desiderio resta nascosto fino alla fine del periodo — se non cambi idea, rimane."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "願いは期間が終わるまで非表示のまま — 気が変わらなければそのまま残ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在到期前心愿保持隐藏 — 如果你没有改变主意,它将会保留。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위시는 기간이 끝날 때까지 숨겨져요 — 마음이 바뀌지 않으면 그대로 남아요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O desejo fica oculto até o fim do período — se você não mudar de ideia, ele continua."
          }
        }
      }
    },
