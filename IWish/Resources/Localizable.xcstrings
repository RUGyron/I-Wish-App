    "“%@” will lose access to the list. To restore it, a new invitation will be required.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” will lose access to the list. To restore it, a new invitation will be required."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» потеряет доступ к списку. Чтобы вернуть — потребуется новое приглашение."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” perderá el acceso a la lista. Para recuperarlo, hará falta una nueva invitación."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ verliert den Zugriff auf die Liste. Für die Rückkehr ist eine neue Einladung erforderlich."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » perdra l’accès à la liste. Pour le restaurer, une nouvelle invitation sera nécessaire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” perderà l’accesso alla lista. Per ripristinarlo serve un nuovo invito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」はリストへのアクセスを失います。戻すには新しい招待が必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」将失去对该列表的访问权限。如需恢复,需要发送新的邀请。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’은(는) 리스트에 대한 접근 권한을 잃어요. 복구하려면 새 초대가 필요해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” perderá o acesso à lista. Para restaurar, será preciso um novo convite."
          }
        }
      }
    },
