          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы отсканировать QR-код, разрешите приложению доступ к камере в Настройках."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para escanear QR, permite el acceso a la cámara en Ajustes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlauben Sie in den Einstellungen den Kamerazugriff, um QR-Codes zu scannen."
          }
        },
        "fr": {
