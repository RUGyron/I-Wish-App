    "No analytics, crashlytics, ads. The app talks only to Firebase servers for sync (encrypted) and Apple for sign-in.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No analytics, crashlytics, ads. The app talks only to Firebase servers for sync (encrypted) and Apple for sign-in."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Никакой аналитики, крашлитики, рекламы. Приложение общается только с серверами Firebase для синхронизации (зашифрованной) и Apple для авторизации."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin analíticas, sin crashlytics, sin anuncios. La app solo se comunica con los servidores de Firebase para sincronizar (cifrado) y con Apple para iniciar sesión."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Analyse, kein Crashlytics, keine Werbung. Die App spricht nur mit Firebase-Servern zur Synchronisation (verschlüsselt) und mit Apple zur Anmeldung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune analyse, aucun crashlytics, aucune pub. L’app ne communique qu’avec les serveurs Firebase pour la synchronisation (chiffrée) et avec Apple pour la connexion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna analisi, nessun crashlytics, nessuna pubblicità. L’app comunica solo con i server Firebase per la sincronizzazione (cifrata) e con Apple per l’accesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "解析、クラッシュ収集、広告は一切なし。アプリは同期のためにFirebaseサーバー(暗号化通信)、サインインのためにAppleとだけ通信します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无分析、无崩溃收集、无广告。App 只与 Firebase 服务器通信用于同步(加密),并与 Apple 通信用于登录。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "분석·크래시 수집·광고가 전혀 없어요. 앱은 동기화를 위해 Firebase 서버(암호화)와, 로그인을 위해 Apple과만 통신해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem análises, crashlytics ou anúncios. O app se comunica apenas com os servidores do Firebase para sincronização (criptografada) e com a Apple para o login."
          }
        }
      }
    },
